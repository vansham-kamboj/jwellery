# Frontend settings. Copy to frontend/.env (never commit .env).
# `node frontend/build-env.js` writes these into frontend/js/env.js (Vercel runs it automatically — set the values in Vercel's Environment Variables).

# Store API (the Laravel backend), e.g. https://api.yourdomain.com/api
AVYA_API_URL=http://127.0.0.1:8000/api
# WhatsApp click-to-chat base
WHATSAPP_API_URL=https://wa.me
