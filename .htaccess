# Serve the storefront (frontend/) at the site root — the address stays https://avyajewels.ca/
DirectoryIndex frontend/index.html index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Project tooling and git data are not part of the website
    RewriteRule ^(tools|\.claude|\.git)(/|$) - [F,L]

    # Old /frontend/ links → the clean address
    RewriteCond %{THE_REQUEST} \s/frontend/?(index\.html)?[\s?]
    RewriteRule ^frontend/?(index\.html)?$ / [R=301,L]

    # Admin panel at /admin (Laravel lives in backend/public; ADMIN_PATH in backend/.env must stay "admin")
    RewriteRule ^admin-assets/(.*)$ backend/public/admin-assets/$1 [L]
    RewriteRule ^admin(/.*)?$ backend/public/index.php [L]

    # Home page
    RewriteRule ^$ frontend/index.html [L]

    # Storefront files (css/, js/ …) asked for at the root are served from frontend/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -f
    RewriteRule ^(.+)$ frontend/$1 [L]

    # Real pages for search engines and web filters (made by tools/build-pages.js): /our-story/, /contact/ … → frontend/<page>/index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/frontend/$1/index.html -f
    RewriteRule ^([a-z0-9-]+)/?$ frontend/$1/index.html [L]
</IfModule>

# Plain text responses always say they are UTF-8, and a few standard safety headers
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Never serve settings files
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Never serve archives, database dumps, backups, logs or scripts, even if one is left on the server by mistake
<FilesMatch "\.(zip|rar|7z|tar|gz|tgz|bz2|sql|sqlite|bak|backup|old|orig|swp|log|ps1|sh|md|lock)$">
    Require all denied
</FilesMatch>
