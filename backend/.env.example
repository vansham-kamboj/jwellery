# ─────────────────────────────────────────────────────────────────────────────
# Store backend settings. Copy to .env and fill in. Never commit .env.
# Every URL, number, account and secret the backend uses is read from here.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Avya Jewels"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Toronto
# Public URL of this backend (API + admin), e.g. https://api.yourdomain.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── External services ───────────────────────────────────────────────────────
# WhatsApp click-to-chat base used for order messages
WHATSAPP_API_URL=https://wa.me
# Web fonts for the admin panel (leave empty to use system fonts)
ADMIN_FONTS_URL="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&family=Jost:wght@400;500;600&display=swap"

# ── Storefronts allowed to call the API (comma-separated, no trailing slash) ─
FRONTEND_URLS=http://localhost:5173

# ── Admin panel ─────────────────────────────────────────────────────────────
# Panel lives at APP_URL/ADMIN_PATH — use something hard to guess in production.
ADMIN_PATH=admin
# First admin account, created by `php artisan db:seed`.
# Remove ADMIN_PASSWORD from .env after the first sign-in.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Store contact (first-run defaults; editable later in Admin → Settings) ──
STORE_WHATSAPP=
STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=
STORE_CURRENCY=CAD
ORDER_PREFIX=AVY
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_X=
SOCIAL_FACEBOOK=

# Where `php artisan db:seed` finds the storefront's images (relative to backend/)
SEED_ASSETS_PATH=../

# ── Sessions, cache, queue, files ───────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once the site runs on HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail (optional, for future order emails) ────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
