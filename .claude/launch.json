{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storefront",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/serve.js",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".claude/backend-local.ps1",
        "serve",
        "--host=127.0.0.1",
        "--port=8000"
      ],
      "port": 8000
    }
  ]
}
